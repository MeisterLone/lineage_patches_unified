From 118100ba6ba948b7e4cae411648291e3b7c9bf93 Mon Sep 17 00:00:00 2001
From: Andy CrossGate Yan <GeForce8800Ultra@gmail.com>
Date: Tue, 11 Aug 2026 09:09:45 +0000
Subject: [PATCH] build: Integrate prop modifications (1/2)

[ported to A16: tools/buildinfo.sh is gone; system/product build.prop is
generated by build/soong scripts/gen_build_prop.py. Version strings bumped to
LineageOS 23.2 and de-personalized (upstream literal was "... Self-built
CGMod", the patch author's own build brand; PORT_TASK section 3 keeps the
mechanism, not the third-party branding). Paired with vendor/lineage
"build: Integrate prop modifications (2/2)", which drops the duplicate
ro.lineage.version/ro.lineage.display.version from config/version.mk.]

Change-Id: I24f54937e3e542b7c29ea86d24e3f523583a0c61
---
 scripts/gen_build_prop.py | 17 +++++------------
 1 file changed, 5 insertions(+), 12 deletions(-)

diff --git a/scripts/gen_build_prop.py b/scripts/gen_build_prop.py
index bdd742469..4e808b8ca 100644
--- a/scripts/gen_build_prop.py
+++ b/scripts/gen_build_prop.py
@@ -105,7 +105,7 @@ def parse_args():
   config["BuildVersionTags"] = build_version_tags
 
   raw_date = args.date_file.read().strip()
-  config["Date"] = subprocess.check_output(["date", "-d", f"@{raw_date}"], text=True).strip()
+  config["Date"] = subprocess.check_output(["date", "-d", f"@{raw_date}", "+%B %-d, %Y"], text=True).strip()
   config["DateUtc"] = subprocess.check_output(["date", "-d", f"@{raw_date}", "+%s"], text=True).strip()
 
   # build_desc is human readable strings that describe this build. This has the same info as the
@@ -220,18 +220,8 @@ def generate_build_info(args):
         print(f"ro.build.display.id={config['BuildId']} {config['BuildKeys']}")
     else:
       print(f"ro.build.display.id={config['LineageDesc']}")
-  elif config["BuildVariant"] != "eng":
-    # User builds should show:
-    # release build number or branch.buld_number non-release builds
-
-    # Dev. branches should have DISPLAY_BUILD_NUMBER set
-    if config["DisplayBuildNumber"]:
-      print(f"ro.build.display.id?={config['BuildId']}.{config['BuildNumber']} {config['BuildKeys']}")
-    else:
-      print(f"ro.build.display.id?={config['BuildId']} {config['BuildKeys']}")
   else:
-    # Non-user builds should show detailed build information (See build desc above)
-    print(f"ro.build.display.id?={config['LineageDesc']}")
+    print(f"ro.build.display.id?={config['BuildId']}")
   print(f"ro.build.version.incremental={config['BuildNumber']}")
   print(f"ro.build.version.sdk={config['Platform_sdk_version']}")
   print(f"ro.build.version.sdk_full={config['Platform_sdk_version_full']}")
@@ -260,6 +250,9 @@ def generate_build_info(args):
   print(f"ro.build.flavor={config['BuildFlavor']}")
 
   print(f"ro.lineage.device={config['LineageDevice']}")
+  print(f"ro.lineage.version=LineageOS 23.2 Self-built")
+  print(f"ro.lineage.display.version=LineageOS 23.2 Self-built")
+  print(f"ro.modversion=LineageOS 23.2 Self-built")
 
   # These values are deprecated, use "ro.product.cpu.abilist"
   # instead (see below).
-- 
2.43.0

