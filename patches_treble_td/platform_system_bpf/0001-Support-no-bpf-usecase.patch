From c32bf748f9f95bf74c3388e57e49bf11a5b71533 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Tue, 11 Aug 2026 09:27:49 +0000
Subject: [PATCH] Support no-bpf usecase

Do not abort the boot when BPF loading fails (BPF-less kernels):
vendorBpfLoader() now falls through to netbpfload done (which sets
bpf.progs_loaded=1) instead of sleep(20)+exit(121), and the rust
bpfloader logs critical-prog / bpf-vendor-mkdir failures instead of
panicking. Forward-port of the lineage-21-td patch from
bpfloader/BpfLoader.cpp (file moved to loader/Loader.cpp + rust
bpfloader.rs at A16).

Change-Id: I75a427a2a41aa4ab1104ad88a891bef0dc2d9c91
---
 loader/Loader.cpp   | 4 ++--
 loader/bpfloader.rs | 9 +++++++--
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/loader/Loader.cpp b/loader/Loader.cpp
index cde6447..c8cef65 100644
--- a/loader/Loader.cpp
+++ b/loader/Loader.cpp
@@ -689,8 +689,8 @@ void vendorBpfLoader() {
         ALOGE("If this triggers randomly, you might be hitting some memory allocation "
               "problems or startup script race.");
         ALOGE("--- DO NOT EXPECT SYSTEM TO BOOT SUCCESSFULLY ---");
-        sleep(20);
-        exit(121);
+        // Do not abort the boot on BPF-less kernels: fall through to
+        // 'netbpfload done', which sets bpf.progs_loaded=1 and exits 0.
     }
 
     const char* args[] = {"/apex/com.android.tethering/bin/netbpfload", "done", NULL};
diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index 34e9b68..2c5023e 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -646,7 +646,11 @@ fn load_libbpf_progs() {
     for file_desc in FILE_ARR {
         if let Err(e) = libbpf_worker(file_desc) {
             if file_desc.critical {
-                panic!("Error when loading {0}: {e}", file_desc.filename);
+                // Do not abort the boot on BPF-less kernels.
+                error!(
+                    "CRITICAL error when loading {0}: {e}; continuing anyway",
+                    file_desc.filename
+                );
             } else {
                 error!("Error when loading {0}: {e}", file_desc.filename);
             }
@@ -675,7 +679,8 @@ fn main() {
     info!("Loading legacy BPF progs");
 
     if let Err(e) = create_dir(Path::new("/sys/fs/bpf/vendor")) {
-        panic!("Error during mkdir /sys/fs/bpf/vendor: {e}");
+        // Do not abort the boot on BPF-less kernels.
+        error!("Error during mkdir /sys/fs/bpf/vendor: {e}; continuing anyway");
     };
 
     // SAFETY: Linking in the existing legacy vendor bpfloader functionality.
-- 
