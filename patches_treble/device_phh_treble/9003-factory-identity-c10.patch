From fe108fa30018243a471b3853593ffc5d95b4ab67 Mon Sep 17 00:00:00 2001
From: builder <builder@fancydebloat.local>
Date: Tue, 11 Aug 2026 06:10:00 +0000
Subject: [PATCH] treble: restore FancyDay C10 factory identity (fingerprint +
 product props + model)

Override the generic TrebleDroid identity with the devices OWN factory values, extracted verbatim from the stock firmware dumps (see re-task/FINDINGS_identity.md). Play-facing keys: ro.build.fingerprint, ro.build.description, ro.build.display.id, ro.product.system.{brand,manufacturer,device,name}, tablet characteristics, and PRODUCT_MODEL := C10.

A16 port note: in-house patch 9001 (cosmetic Allwinner A523 model) is retired, so the factory model C10 is now set directly here via PRODUCT_MODEL. ro.build.version.{sdk,release} and security_patch stay truthful to the actual build; ro.product.first_api_level is inherited from stock vendor (34).

A16 mechanism note (differs from the A14 original):
* system/build.prop is generated by Soong (build/soong/scripts/gen_build_prop.py),
  not by the Make buildinfo.sh path. The only accepted PRODUCT_BUILD_PROP_OVERRIDES
  keys are the soong product-config names. The A14 names TARGET_BUILD_FINGERPRINT and
  PRIVATE_BUILD_DESC make gen_build_prop.py abort the build with
  'Key ... isnt a valid prop override', so BuildFingerprint / BuildDesc are used.
  BuildDesc is kept last because its value contains spaces and is rejoined from the
  words that follow it (override_config()).
* ro.product.system.{brand,manufacturer,device,name} are emitted non-optionally by
  generate_common_build_props(), so assigning them again through
  PRODUCT_SYSTEM_DEFAULT_PROPERTIES makes post_process_props.py fail with
  'found duplicate sysprop assignments'. They are therefore set through the
  registered PRODUCT_SYSTEM_* product vars (PRODUCT_SYSTEM_MODEL defaults to
  PRODUCT_MODEL = C10).
* ro.build.fingerprint, ro.system.build.fingerprint and ro.build.display.id are
  emitted with '?=' (optional), so plain assignments in
  PRODUCT_SYSTEM_DEFAULT_PROPERTIES override them cleanly and also cover the case
  where PRODUCT_BUILD_PROP_OVERRIDES is not honoured.

Change-Id: I4b2f8a1c6d3e5f7a9b0c1d2e3f4a5b6c7d8e9f0a
---
 generate.sh | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/generate.sh b/generate.sh
index 6f876a3..be11469 100644
--- a/generate.sh
+++ b/generate.sh
@@ -94,11 +94,30 @@ $rom_script
 PRODUCT_NAME := $target
 PRODUCT_DEVICE := tdgsi_${arch}_$part
 PRODUCT_BRAND := google
-PRODUCT_SYSTEM_BRAND := google
-PRODUCT_MODEL := TrebleDroid $apps_name
+PRODUCT_MODEL := C10
 
 # Overwrite the inherited "emulator" characteristics
-PRODUCT_CHARACTERISTICS := device
+# --- Factory identity: FancyDay C10 (verbatim from stock dumps; re-task/FINDINGS_identity.md) ---
+# The model is PRODUCT_MODEL above (in-house patch 9001 retired).
+PRODUCT_CHARACTERISTICS := tablet
+# ro.product.system.* are emitted non-optionally by the build system, so they have to be
+# set through the registered PRODUCT_SYSTEM_* product vars. Assigning the same keys again
+# through PRODUCT_SYSTEM_DEFAULT_PROPERTIES aborts the build with
+# "found duplicate sysprop assignments" (build/make/tools/post_process_props.py).
+PRODUCT_SYSTEM_BRAND := FancyDay
+PRODUCT_SYSTEM_MANUFACTURER := FancyDay
+PRODUCT_SYSTEM_DEVICE := C10
+PRODUCT_SYSTEM_NAME := C10US
+# PRODUCT_SYSTEM_MODEL defaults to PRODUCT_MODEL, i.e. ro.product.system.model=C10.
+# The properties below are emitted with "?=" by build/soong/scripts/gen_build_prop.py,
+# so a plain assignment overrides them cleanly.
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.build.fingerprint=FancyDay/C10US/C10:14/UP1A.231105.001.A1/20240316:user/release-keys ro.system.build.fingerprint=FancyDay/C10US/C10:14/UP1A.231105.001.A1/20240316:user/release-keys ro.build.display.id=863C_C10_20240619
+# On Android 16 the valid PRODUCT_BUILD_PROP_OVERRIDES keys are the soong product-config
+# names (BuildFingerprint, BuildDesc). The Android 14 names TARGET_BUILD_FINGERPRINT and
+# PRIVATE_BUILD_DESC make gen_build_prop.py exit with "isn't a valid prop override".
+# BuildDesc must stay last: its value contains spaces and is rejoined from the words
+# that follow it.
+PRODUCT_BUILD_PROP_OVERRIDES += BuildFingerprint=FancyDay/C10US/C10:14/UP1A.231105.001.A1/20240316:user/release-keys BuildDesc="a523_y83_arm64-user 14 UP1A.231105.001.A1 20240316 release-keys"
 
 PRODUCT_PACKAGES += $extra_packages
 
-- 
2.43.0

