From b2941e91f94e550bd488eeea7a3f2c5834bfbc78 Mon Sep 17 00:00:00 2001
From: Paul Nel <paul@fashionpass.com>
Date: Wed, 12 Aug 2026 01:32:49 +0000
Subject: [PATCH] treble: Do not advertise cellular hardware on C10

The C10 slot is microSD, embedded telephony is false, and no modem is present. Stop installing the GSM/IMS feature XMLs while retaining framework compatibility code.

Generated with [Devin](https://devin.ai)

Co-Authored-By: Devin <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 base.mk | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/base.mk b/base.mk
index c7cd915..1f2c3b1 100644
--- a/base.mk
+++ b/base.mk
@@ -1,9 +1,7 @@
-# Huawei devices don't declare fingerprint and telephony hardware feature
+# Some devices don't declare the fingerprint hardware feature
 # TODO: Proper detection
 PRODUCT_COPY_FILES := \
     frameworks/native/data/etc/android.hardware.fingerprint.xml:system/etc/permissions/android.hardware.fingerprint.xml \
-    frameworks/native/data/etc/android.hardware.telephony.gsm.xml:system/etc/permissions/android.hardware.telephony.gsm.xml \
-    frameworks/native/data/etc/android.hardware.telephony.ims.xml:system/etc/permissions/android.hardware.telephony.ims.xml \
     frameworks/native/data/etc/android.hardware.bluetooth.xml:system/etc/permissions/android.hardware.bluetooth.xml \
     frameworks/native/data/etc/android.hardware.bluetooth_le.xml:system/etc/permissions/android.hardware.bluetooth_le.xml \
     frameworks/native/data/etc/android.hardware.usb.host.xml:system/etc/permissions/android.hardware.usb.host.xml \
