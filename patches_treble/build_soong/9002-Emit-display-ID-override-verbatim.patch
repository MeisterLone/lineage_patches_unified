From a5d63928d1f6f32101ab3ea148f0b82feb522698 Mon Sep 17 00:00:00 2001
From: Paul Nel <paul@fashionpass.com>
Date: Tue, 11 Aug 2026 23:44:30 +0000
Subject: [PATCH] gen_build_prop: Emit display ID override verbatim

Keep default AOSP display formatting when unset, but preserve an explicitly researched product display ID without appending build number or key tags.

Generated with [Devin](https://devin.ai)

Co-Authored-By: Devin <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Change-Id: Ia69fdd83b84892c6e777c49356ab6a71ddbe2a59
---
 scripts/gen_build_prop.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/scripts/gen_build_prop.py b/scripts/gen_build_prop.py
index 1ea824a09..d82e3335e 100644
--- a/scripts/gen_build_prop.py
+++ b/scripts/gen_build_prop.py
@@ -126,7 +126,7 @@ def parse_args():
   if config["BuildNumber"].startswith("eng."):
     config["BuildNumber"] = config["DateUtc"]
 
-  config["BuildDisplayId"] = config["BuildId"]
+  config["BuildDisplayId"] = ""
   override_config(config)
   if args.partition == "system":
     config['ProductBrand'] = config['SystemBrand']
@@ -210,7 +210,10 @@ def generate_build_info(args):
   print(f"ro.build.id?={config['BuildId']}")
 
   # ro.build.display.id is shown under Settings -> About Phone
-  if args.partition == "product":
+  if config["BuildDisplayId"]:
+    suffix = "" if args.partition == "product" else "?"
+    print(f"ro.build.display.id{suffix}={config['BuildDisplayId']}")
+  elif args.partition == "product":
     # Some vendors override build id in odm or vendor, such as oplus.
     # Keep a forced copy of the true build display id in the product
     # partition prop so that a forced vendor/odm override cannot win.
-- 
