-        append(hexColorString(colors[0]))
-        return
-    }
-    append("<ColorStateList size=")
-    append(colors.size.toString())
-    append(" default=")
-    append(hexColorString(colorStateList.defaultColor))
-    append(">")
-}
-
-private fun Appendable.appendColorFilter(colorFilter: ColorFilter?) {
