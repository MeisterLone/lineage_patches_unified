-        ?.let {
-            append(" colorFilter=")
-            appendColorFilter(it)
-        }
-    when (drawable) {
-        is DrawableWrapper -> {
-            append(" wrapped=")
-            appendDrawable(drawable.drawable)
-        }
-        is LayerDrawable -> {
-            if (drawable is RippleDrawable) {
-                drawable.getStateField<ColorStateList>("mColor")?.let {
-                    append(" color=")
