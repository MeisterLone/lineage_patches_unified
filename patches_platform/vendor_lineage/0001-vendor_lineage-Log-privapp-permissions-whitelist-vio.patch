From 2515a979a8b6380296994b48151c73916c27cb8c Mon Sep 17 00:00:00 2001
From: port-worker <port-worker@localhost>
Date: Tue, 11 Aug 2026 08:46:26 +0000
Subject: [PATCH] vendor_lineage: Log privapp-permissions whitelist violations
 instead

Change-Id: I49dba61f332253e291a65e79ca70d9a07d45bb07
---
 config/common.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 3b68625f..208f6bb2 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -103,9 +103,9 @@ PRODUCT_PACKAGES += \
 PRODUCT_COPY_FILES += \
     vendor/lineage/config/permissions/org.lineageos.android.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/org.lineageos.android.xml
 
-# Enforce privapp-permissions whitelist
+# Log privapp-permissions whitelist violations
 PRODUCT_PRODUCT_PROPERTIES += \
-    ro.control_privapp_permissions=enforce
+    ro.control_privapp_permissions=log
 
 ifneq ($(TARGET_DISABLE_LINEAGE_SDK), true)
 # Lineage SDK
-- 
2.43.0

